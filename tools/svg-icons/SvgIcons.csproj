<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool, never referenced by the app: Svg.Skia stays out of Veneer itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>svg-icons</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Veneer.Core\Veneer.Core.csproj" />
  </ItemGroup>

</Project>
