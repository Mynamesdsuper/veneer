<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Veneer.Core\Veneer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows 11 22H2 is the minimum (CLAUDE.md). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32 generates arch-specific structs (e.g. APPBARDATA); AnyCPU cannot. See docs/decisions.md. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>

</Project>
