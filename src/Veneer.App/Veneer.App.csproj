<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Veneer.Core\Veneer.Core.csproj" />
    <ProjectReference Include="..\Veneer.Interop\Veneer.Interop.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 11 22H2 is the minimum (CLAUDE.md). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Veneer.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled themes ship next to the executable: themes\<name>\... -->
    <None Include="../../themes/**/*" Exclude="../../themes/README.md" LinkBase="themes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
